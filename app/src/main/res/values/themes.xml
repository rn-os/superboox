<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain black-on-white Material theme; no animations, e-ink friendly. -->
    <style name="Theme.SuperBoox" parent="@android:style/Theme.DeviceDefault.Light">
        <item name="android:colorPrimary">#000000</item>
        <item name="android:colorPrimaryDark">#000000</item>
        <item name="android:colorAccent">#000000</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.SuperBoox.Invisible" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">true</item>
    </style>
</resources>
